{
  "manifest_version": 3,
  "name": "Career Bot для hh.ru",
  "version": "2.3.8",
  "description": "Добавляет вакансии, импортирует профиль и последовательно отправляет простые одобренные отклики из локального Career Bot.",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://api.hh.ru/*",
    "https://hh.ru/*",
    "https://*.hh.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hh.ru/*",
        "https://*.hh.ru/*"
      ],
      "js": ["content.js", "diagnostic.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
